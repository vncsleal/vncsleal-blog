---
import type { Author } from "@blog/domain"

interface Props {
  author: Author | null
  siteTitle: string
}

const { author, siteTitle } = Astro.props
const socials = Object.entries(author?.social ?? {})
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="footer-grid">
    <div class="footer-author">
      {
        author?.photo && (
          <img
            class="footer-photo"
            src={`${author.photo}?w=144&h=144&fit=crop&auto=format`}
            alt={author.name}
            width="72"
            height="72"
            loading="lazy"
          />
        )
      }
      <div>
        <p class="mono footer-kicker">Sobre o autor</p>
        <p class="footer-name">
          <a href="/autor">{author?.name ?? "O Autor"}</a>
        </p>
        {author?.bio && <p class="footer-bio">{author.bio}</p>}
        <a class="mono footer-profile" href="/autor">Perfil completo →</a>
        {
          socials.length > 0 && (
            <ul class="footer-social mono">
              {socials.map(([platform, url]) => (
                <li>
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {platform} ↗
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
    <nav class="footer-links mono" aria-label="Rodapé">
      <a href="/">Ensaios</a>
      <a href="/autor">Autor</a>
      <a href="/rss.xml">RSS</a>
      <a href="/sitemap.xml">Sitemap</a>
    </nav>
  </div>

  <div class="footer-word" aria-hidden="true">
    {
      siteTitle
        .split("")
        .map((ch) => (ch === "." ? <span class="accent">.</span> : ch))
    }
  </div>

  <div class="footer-base mono">
    <span>© {year} {siteTitle}</span>
    <a href="/rss.xml">Assinar via RSS</a>
  </div>
</footer>
