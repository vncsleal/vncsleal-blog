---
interface Props {
  pageTitle: string
  seoDescription: string | null
  topics: { slug: string; title: string }[]
  activeTopic: string | null
}

const { pageTitle, seoDescription, topics, activeTopic } = Astro.props

const titleChars = (() => {
  let ki = 0
  return pageTitle.split(" ").map((word) => word.split("").map((ch) => ({ ch, ki: ki++ })))
})()
---

<section class="hero">
  <h1 class="hero-title" data-kinetic data-brand-title aria-label={pageTitle}>
    {
      titleChars.map((word, wi) => (
        <>
          {wi > 0 && " "}
          <span class="kn-word" aria-hidden="true">
            {word.map(({ ch, ki }) => (
              <span class="kn-mask">
                <span class:list={["kn-char", { accent: ch === "." }]} style={`--ki:${ki}`}>
                  {ch}
                </span>
              </span>
            ))}
          </span>
        </>
      ))
    }
  </h1>

  <div class="hero-foot">
    <p class="hero-sub" data-reveal>
      {seoDescription ?? "Ensaios sobre tecnologia, cultura e o ofício de fazer."}
    </p>
  </div>

  <nav class="pills" aria-label="Filtrar por tema" data-reveal>
    <a href="/" class:list={["pill", { active: !activeTopic }]}>Todos</a>
    {
      topics.map((topic) => (
        <a
          href={`/topic/${topic.slug}`}
          class:list={["pill", { active: activeTopic === topic.slug }]}
        >
          {topic.title}
        </a>
      ))
    }
    <a href="/rss.xml" class="pill pill-rss">RSS</a>
  </nav>
</section>
