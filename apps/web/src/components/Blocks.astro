---
import { img, srcset } from "../lib/utils"
import { renderChildren } from "../lib/render"

interface Props {
  blocks: any[]
  dropcap?: boolean
}

const { blocks, dropcap = false } = Astro.props
const firstTextIdx = blocks.findIndex((b) => b._type !== "image")
---

{
  blocks.map((block, bi) => {
    if (block._type === "image" && block.url) {
      return (
        <figure class="a-figure" data-reveal>
          <img
            src={img(block.url, 1360)}
            srcset={srcset(block.url, [680, 1024, 1360, 1800])}
            sizes="(max-width: 700px) 100vw, 680px"
            alt=""
            loading="lazy"
            data-lightbox
          />
        </figure>
      )
    }
    const html = renderChildren(block.children, block.markDefs)
    if (block.style === "h2") {
      return <h2 data-reveal set:html={html} />
    }
    if (block.style === "h3") {
      return <h3 data-reveal set:html={html} />
    }
    if (block.style === "blockquote") {
      return (
        <blockquote data-reveal>
          <p set:html={html} />
        </blockquote>
      )
    }
    return <p class:list={[{ dropcap: dropcap && bi === firstTextIdx }]} set:html={html} />
  })
}
